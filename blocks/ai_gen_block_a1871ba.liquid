{% doc %}
  @prompt
    a carousel of gallery but with videos, I dont want to upload videos but fetch videos via instagram, so can you just let me add link of the video also? 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
  }

  .ai-video-carousel__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-video-carousel__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-video-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slides_per_view | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view }});
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #000;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.video_aspect_ratio }}%;
    background-color: #000;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #1a1a1a;
    color: #666;
    font-size: 14px;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }}.playing {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-carousel__play-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    margin-left: 3px;
  }

  .ai-video-carousel__caption-{{ ai_gen_id }} {
    padding: 15px;
    background-color: {{ block.settings.caption_bg_color }};
    color: {{ block.settings.caption_text_color }};
  }

  .ai-video-carousel__caption-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 5px;
  }

  .ai-video-carousel__caption-text-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
  }

/* --- FIXED ARROW DESIGN & POSITION --- */
.ai-video-carousel__nav-{{ ai_gen_id }} {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 9999px;
  background: rgba(0,0,0,.65); /* darker for visibility */
  border: 0;
  display: grid;
  place-items: center;
  cursor: pointer;
  z-index: 5; /* ensures above video iframe */
  box-shadow: 0 4px 12px rgba(0,0,0,.25);
  transition: all 0.3s ease;
}

/* position slightly outside carousel edges */
.ai-video-carousel__nav--prev-{{ ai_gen_id }} { left: -18px; }
.ai-video-carousel__nav--next-{{ ai_gen_id }} { right: -18px; }

/* draw chevrons (no SVG needed) */
.ai-video-carousel__nav-{{ ai_gen_id }}::before {
  content: "";
  width: 14px;
  height: 14px;
  display: block;
  border-right: 3px solid #fff;
  border-bottom: 3px solid #fff;
}
.ai-video-carousel__nav--prev-{{ ai_gen_id }}::before { transform: rotate(135deg); } /* ← */
.ai-video-carousel__nav--next-{{ ai_gen_id }}::before { transform: rotate(-45deg); } /* → */

/* hover and disabled states */
.ai-video-carousel__nav-{{ ai_gen_id }}:hover {
  background: rgba(0,0,0,.85);
  transform: translateY(-50%) scale(1.1);
}
.ai-video-carousel__nav-{{ ai_gen_id }}:disabled {
  opacity: .35;
  cursor: not-allowed;
}
.ai-video-carousel__nav-{{ ai_gen_id }}:disabled:hover {
  transform: translateY(-50%);
}
.ai-video-carousel__nav-{{ ai_gen_id }} svg { display: none; }

  .ai-video-carousel__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-video-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__nav-{{ ai_gen_id }}:disabled:hover {
    transform: translateY(-50%);
  }

  .ai-video-carousel__nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    color: {{ block.settings.nav_icon_color }};
  }

  .ai-video-carousel__nav--prev-{{ ai_gen_id }} {
    left: -20px;
  }

  .ai-video-carousel__nav--next-{{ ai_gen_id }} {
    right: -20px;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (max-width: 989px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.slides_per_view_tablet | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.slides_per_view_tablet }});
    }

    .ai-video-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-video-carousel__nav-{{ ai_gen_id }} {
      width: 35px;
      height: 35px;
    }

    .ai-video-carousel__nav--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-video-carousel__nav--next-{{ ai_gen_id }} {
      right: 10px;
    }

    .ai-video-carousel__play-button-{{ ai_gen_id }} {
      width: 50px;
      height: 50px;
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }} class="ai-video-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-video-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-video-carousel__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-carousel__track-wrapper-{{ ai_gen_id }}">
      {% if block.settings.show_navigation %}
        <button
          class="ai-video-carousel__nav-{{ ai_gen_id }} ai-video-carousel__nav--prev-{{ ai_gen_id }}"
          aria-label="Previous slide"
          data-nav="prev"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {% endif %}

      <div class="ai-video-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..6) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign video_url_key = 'video_url_' | append: i 
            assign title_key = 'video_' | append: i | append: '_title'
            assign caption_key = 'video_' | append: i | append: '_caption'
            assign video = block.settings[video_key]
            assign video_url = block.settings[video_url_key]
            assign title = block.settings[title_key]
            assign caption = block.settings[caption_key]
          %}

          {% if video != blank or video_url != blank %}
            <div class="ai-video-carousel__slide-{{ ai_gen_id }}" data-slide>
              <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                {% if video_url != blank %}

                {%- assign _url = video_url -%}

{%- comment -%} Build provider-specific embed URLs {%- endcomment -%}
{% if _url contains 'instagram.com' %}
  {%- comment -%} Accepts /reel/{id}, /p/{id}, /tv/{id} — stories aren’t embeddable. {%- endcomment -%}
  {% if _url contains '/reel/' %}
    {% assign ig_id = _url | split: '/reel/' | last | split: '/' | first %}
    {% assign embed_url = 'https://www.instagram.com/reel/' | append: ig_id | append: '/embed' %}
  {% elsif _url contains '/p/' %}
    {% assign ig_id = _url | split: '/p/' | last | split: '/' | first %}
    {% assign embed_url = 'https://www.instagram.com/p/' | append: ig_id | append: '/embed' %}
  {% elsif _url contains '/tv/' %}
    {% assign ig_id = _url | split: '/tv/' | last | split: '/' | first %}
    {% assign embed_url = 'https://www.instagram.com/tv/' | append: ig_id | append: '/embed' %}
  {% else %}
    {% assign embed_url = '' %}
  {% endif %}

  {% if embed_url != '' %}
    <div class="ai-video-embed-wrap">
      <iframe
        class="ai-video-carousel__iframe-{{ ai_gen_id }}"
        src="{{ embed_url }}"
        allow="clipboard-write; encrypted-media; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        loading="lazy"
        style="background:#000"
      ></iframe>
    </div>
  {% else %}
    <div class="ai-video-carousel__placeholder-{{ ai_gen_id }}">Instagram URL not embeddable</div>
  {% endif %}

{% elsif _url contains 'youtu.be' or _url contains 'youtube.com' %}
  {%- comment -%} Normalize YouTube to /embed/{id} {%- endcomment -%}
  {% if _url contains 'youtu.be/' %}
    {% assign yt_id = _url | split: 'youtu.be/' | last | split: '?' | first %}
  {% elsif _url contains 'watch?v=' %}
    {% assign yt_id = _url | split: 'watch?v=' | last | split: '&' | first %}
  {% else %}
    {% assign yt_id = _url | split: '/' | last | split: '?' | first %}
  {% endif %}
  <div class="ai-video-embed-wrap">
    <iframe
      class="ai-video-carousel__iframe-{{ ai_gen_id }}"
      src="https://www.youtube.com/embed/{{ yt_id }}"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
      loading="lazy"
    ></iframe>
  </div>

{% elsif _url contains 'vimeo.com' %}
  {%- comment -%} Normalize Vimeo to player.vimeo.com/video/{id} {%- endcomment -%}
  {% assign vimeo_id = _url | split: 'vimeo.com/' | last | split: '/' | first | split: '?' | first %}
  <div class="ai-video-embed-wrap">
    <iframe
      class="ai-video-carousel__iframe-{{ ai_gen_id }}"
      src="https://player.vimeo.com/video/{{ vimeo_id }}"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
      loading="lazy"
    ></iframe>
  </div>

{% else %}
  {%- comment -%} Fall back to native <video> for direct .mp4/.webm links {%- endcomment -%}
  <video
    class="ai-video-carousel__video-{{ ai_gen_id }}"
    src="{{ _url }}"
    {% if block.settings.enable_loop %}loop{% endif %}
    {% if block.settings.enable_mute %}muted{% endif %}
    playsinline preload="metadata" controls
  ></video>
{% endif %}


                 
