{% doc %}
  @prompt
    create a default contact form, create a form with only one field where customer can write their reviews after purchasing goods, please keep the submit review button center align
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-form-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-review-form__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-review-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-review-form__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
    opacity: 0.8;
  }

  .ai-review-form__field-wrapper-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-review-form__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-review-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.textarea_height }}px;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-family: inherit;
    font-size: 16px;
    resize: vertical;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
  }

  .ai-review-form__textarea-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-review-form__textarea-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    opacity: 0.7;
  }

  .ai-review-form__button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-review-form__button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: {% if block.settings.button_full_width %}100%{% else %}auto{% endif %};
  }

  .ai-review-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-review-form__success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 16px;
    padding: 12px;
    background-color: {{ block.settings.success_bg_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    text-align: center;
  }

  .ai-review-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 8px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-review-form-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-review-form__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<review-form-{{ ai_gen_id }}
  class="ai-review-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact' -%}
    <input
      type="hidden"
      name="contact[subject]"
      value="Customer Review"
    >
    <div class="ai-review-form__content-{{ ai_gen_id }}">
      {%- if block.settings.heading != blank -%}
        <h2 class="ai-review-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div class="ai-review-form__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {%- endif -%}

      <div class="ai-review-form__field-wrapper-{{ ai_gen_id }}">
        <label
          for="ai-review-textarea-{{ ai_gen_id }}"
          class="ai-review-form__label-{{ ai_gen_id }}"
        >
          {{ block.settings.field_label }}
        </label>
        <textarea
          id="ai-review-textarea-{{ ai_gen_id }}"
          name="contact[body]"
          class="ai-review-form__textarea-{{ ai_gen_id }}"
          placeholder="{{ block.settings.placeholder_text }}"
          required
          aria-required="true"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="ai-review-form-error-{{ ai_gen_id }}"
          {% endif %}
          {% if form.posted_successfully? %}
            aria-describedby="ai-review-form-success-{{ ai_gen_id }}"
          {% endif %}
        ></textarea>
        {%- if form.errors -%}
          <div
            id="ai-review-form-error-{{ ai_gen_id }}"
            class="ai-review-form__error-{{ ai_gen_id }}"
          >
            <span>{{ form.errors.messages.body }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="ai-review-form__button-wrapper-{{ ai_gen_id }}">
        <button
          type="submit"
          class="ai-review-form__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>
      </div>

      {%- if form.posted_successfully? -%}
        <div
          id="ai-review-form-success-{{ ai_gen_id }}"
          class="ai-review-form__success-{{ ai_gen_id }}"
        >
          <span>{{ block.settings.success_message }}</span>
        </div>
      {%- endif -%}
    </div>
  {%- endform -%}
</review-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const form = this.querySelector('form');
        const textarea = this.querySelector('.ai-review-form__textarea-{{ ai_gen_id }}');
        
        if (form && textarea) {
          form.addEventListener('submit', function(e) {
            if (!textarea.value.trim()) {
              e.preventDefault();
              textarea.focus();
            }
          });
        }
      }
    }

    customElements.define('review-form-{{ ai_gen_id }}', ReviewForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Customer review form",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Share your review"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "We'd love to hear about your experience with our products"
    },
    {
      "type": "inline_richtext",
      "id": "field_label",
      "label": "Field label",
      "default": "Your review"
    },
    {
      "type": "inline_richtext",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "Tell us what you think..."
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Submit review"
    },
    {
      "type": "inline_richtext",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for your review! We appreciate your feedback."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Description spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Form field"
    },
    {
      "type": "range",
      "id": "textarea_height",
      "label": "Textarea height",
      "min": 100,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "input_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "input_focus_color",
      "label": "Focus outline",
      "default": "#0b61cd"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Full width button",
      "default": false
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Form border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success text",
      "default": "#0d8756"
    },
    {
      "type": "color",
      "id": "success_bg_color",
      "label": "Success background",
      "default": "#e0efe4"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error",
      "default": "#c4301c"
    }
  ],
  "presets": [
    {
      "name": "Customer review form"
    }
  ]
}
{% endschema %}
