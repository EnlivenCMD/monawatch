{%- comment -%} ============================================================
  REVAMP JUN26 — Featured Brands
  File: sections/revamp-june26-featured-brands.liquid
  Status: TEST ONLY — do not publish to live until approved
  Design ref: Figma "monawatch 2025" / featured brands cards (Seiko, Orient)
================================================================ {%- endcomment -%}

{%- style -%}
  .rj26-feat-brands {
    background: #ffffff;
    padding: var(--rj26-fb-pt) 0 var(--rj26-fb-pb);
  }

  .rj26-feat-brands__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .rj26-feat-brands__header {
    margin-bottom: 20px;
  }

  .rj26-feat-brands__heading {
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    margin: 0 0 6px;
    line-height: 1.2;
  }

  .rj26-feat-brands__subheading {
    font-size: 14px;
    color: #666666;
    margin: 0;
    line-height: 1.4;
  }

  /* Grid: 2 columns desktop, 1 column mobile */
  .rj26-feat-brands__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 749px) {
    .rj26-feat-brands__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Brand card */
  .rj26-brand-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #121628;
    border-radius: 10px;
    overflow: hidden;
    padding: 28px 20px 20px;
    text-decoration: none;
    min-height: 340px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rj26-brand-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  }

  /* Top: logo / name + tagline */
  .rj26-brand-card__top {
    margin-bottom: 16px;
  }

  .rj26-brand-card__logo {
    max-height: 40px;
    max-width: 160px;
    width: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto 6px;
  }

  .rj26-brand-card__name {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 4px;
    line-height: 1.1;
  }

  .rj26-brand-card__tagline {
    font-size: 11px;
    color: #9ba3bf;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0;
    line-height: 1.3;
  }

  /* Middle: product/brand image */
  .rj26-brand-card__image-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 8px 0 20px;
  }

  .rj26-brand-card__image-wrap img {
    width: 100%;
    max-height: 210px;
    object-fit: contain;
    object-position: center;
  }

  /* Bottom: CTA button */
  .rj26-brand-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1964ae;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 11px 26px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .rj26-brand-card:hover .rj26-brand-card__btn {
    background: #0f4a87;
  }
{%- endstyle -%}

<style>
  #rj26-feat-brands-{{ section.id }} {
    --rj26-fb-pt: {{ section.settings.padding_top }}px;
    --rj26-fb-pb: {{ section.settings.padding_bottom }}px;
  }
</style>

<section
  class="rj26-feat-brands"
  id="rj26-feat-brands-{{ section.id }}"
>
  <div class="rj26-feat-brands__inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="rj26-feat-brands__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="rj26-feat-brands__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="rj26-feat-brands__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="rj26-feat-brands__grid">
      {%- for block in section.blocks -%}
        {%- assign col_handle = block.settings.collection -%}
        {%- assign col_obj = collections[col_handle] -%}

        <a
          href="{% if col_handle != blank %}/collections/{{ col_handle }}{% else %}#{% endif %}"
          class="rj26-brand-card"
          {{ block.shopify_attributes }}
          aria-label="{{ block.settings.brand_name | escape }}"
        >
          <div class="rj26-brand-card__top">
            {%- if block.settings.logo != blank -%}
              <img
                src="{{ block.settings.logo | image_url: height: 80 }}"
                alt="{{ block.settings.brand_name | escape }}"
                class="rj26-brand-card__logo"
                loading="lazy"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
              >
            {%- else -%}
              <p class="rj26-brand-card__name">{{ block.settings.brand_name }}</p>
            {%- endif -%}
            {%- if block.settings.tagline != blank -%}
              <p class="rj26-brand-card__tagline">{{ block.settings.tagline }}</p>
            {%- endif -%}
          </div>

          <div class="rj26-brand-card__image-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 600 }} 600w
                "
                sizes="(max-width: 749px) 90vw, 45vw"
                alt="{{ block.settings.brand_name | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- elsif col_obj != blank and col_obj.products.first.featured_image != blank -%}
              <img
                src="{{ col_obj.products.first.featured_image | image_url: width: 600 }}"
                alt="{{ block.settings.brand_name | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </div>

          {%- if block.settings.button_label != blank -%}
            <span class="rj26-brand-card__btn" aria-hidden="true">
              {{- block.settings.button_label -}}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </span>
          {%- endif -%}
        </a>

      {%- else -%}
        <p style="color:#999;grid-column:1/-1;">Add brand blocks in the theme editor.</p>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "[REVAMP JUN26] Featured Brands",
  "tag": "section",
  "class": "rj26-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "⚠️ REVAMP JUN26 — Test only. Do not add to live theme until approved."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "FEATURED WATCH BRANDS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Explore original watches from trusted global brands."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Card",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name",
          "default": "BRAND NAME"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline (below brand name)",
          "default": "BUILT FOR PERFECTION"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (sets the card link)"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo image (optional — replaces text name)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product / brand image (centre of card)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[REVAMP JUN26] Featured Brands",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "SEIKO",
            "tagline": "BUILT FOR PERFECTION",
            "button_label": "SHOP SEIKO"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "ORIENT",
            "tagline": "ENGINEERED ELEGANCE",
            "button_label": "SHOP ORIENT"
          }
        }
      ]
    }
  ]
}
{% endschema %}
