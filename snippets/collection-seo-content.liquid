{% assign seo_content = collection.metafields.custom.seo_content %}

{% if seo_content != blank %}
  <div class="collection-seo-wrapper">
    <div class="collection-seo-content" id="seoContent">
      {{ seo_content | metafield_tag }}
    </div>

    <button class="seo-toggle" id="seoToggle">
      Read more
    </button>
  </div>
{% endif %}


<style>
.collection-seo-wrapper {
  position: relative;
  max-width: 900px;
  margin: 40px auto;
}

@media (max-width: 768px){
.collection-seo-wrapper{
padding: 10px 10px;
}
}

.collection-seo-content {
  max-height: 140px; /* adjust how many lines you want visible */
  overflow: hidden;
  position: relative;
  transition: max-height 0.4s ease;
}

.collection-seo-content::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60px;
  background: linear-gradient(to bottom, rgba(255,255,255,0), #fff);
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.collection-seo-wrapper.expanded .collection-seo-content {
  max-height: 2000px;
}

.collection-seo-wrapper.expanded .collection-seo-content::after {
  opacity: 0;
}

.seo-toggle {
  display: block;
  margin: 15px auto 0;
  background: none;
  border: none;
  font-weight: 600;
  cursor: pointer;
  text-decoration: underline;
}
</style>


<script>
document.addEventListener("click", function (e) {
  const button = e.target.closest(".seo-toggle");
  if (!button) return;

  const wrapper = button.closest(".collection-seo-wrapper");
  if (!wrapper) return;

  wrapper.classList.toggle("expanded");

  button.textContent = wrapper.classList.contains("expanded")
    ? "Read less"
    : "Read more";
});
</script>