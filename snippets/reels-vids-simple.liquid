<style>
  /* spacing */
  .reels-title { margin: 10 16px 10px; font-size:22px;font-weight: 500; }
  .reels-subtitle { margin: 9px 16px 20px 0px; color:#666;font-size: 17px; }

  /* simple slider */
  .reels-track{
    display: grid;
    grid-auto-flow: column;
    gap: 14px;
    overflow-x: auto;
    padding: 50px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    margin: 16px 10px 10px 10px;
    padding: 10px 10px 10px 10px;
  }
  /* 4 per view on desktop, 2 on tablet, 1 on mobile */
  .reels-track{ grid-auto-columns: 20%; }
  @media (max-width: 991px){ .reels-track{ grid-auto-columns: 50%; } }
  @media (max-width: 575px){ .reels-track{ grid-auto-columns: 40%; } }

  

  .reel{ scroll-snap-align: start; }
  
  .reel-frame{
    background:#000;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 9/16;
  }
  .reel-video{
    width:100%; height:100%; display:block; object-fit:cover;
  }
  .reel-caption{ margin:8px 4px 0; font-size:.9rem; color: rgba(0,0,0,.75); }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const videos = document.querySelectorAll('.reel-video');

  videos.forEach(function(video){

    // When user presses play (via controls or tap)
    video.addEventListener('play', function () {
      video.muted = false;
    });

    // Pause other videos when one starts playing
    video.addEventListener('play', function () {
      videos.forEach(function(other){
        if(other !== video){
          other.pause();
        }
      });
    });

  });

});
</script>
